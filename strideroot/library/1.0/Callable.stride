type _MainInputPort {
	typeName: "mainInputPort"
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _MainOutputPort {
	typeName: "mainOutputPort"
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _PropertyInputPort {
	typeName: "propertyInputPort"
	properties: [
	]
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _PropertyOutputPort {
	typeName: "propertyOutputPort"
	properties: [
	]
	inherits: [_Port, _PortAttributes]
	meta: ""
}

type _PortAttributes {
	typeName: "_portAttributes"
	properties: [
		typeProperty Rate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_RealLiteral, _IntLiteral, _NoneLiteral] }
			default: 0
			writeable: off
			public: on
			required: off
			meta: "Rate of the block connected to the port, populated by the compiler from stream connections"
		},
		typeProperty Domain {
			name: "domain"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _DomainDefinition, _NoneLiteral] } # This should be made to accept type handles
			default: none
			writeable: off
			public: on
			required: off
			meta: "Domain of the block connected to the port, populated by the compiler from stream connections"
		},
		typeProperty Type {
			name: "type"
			allowedTypes: constrainedEntity { allowed: [_DataTypes, _NoneLiteral] }
			default: none
			writeable: off
			public: on
			required: off
			meta: "Data type of the block connected to the port, populated by the compiler from stream connections"
		},
		typeProperty Size {
			name: "size"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] } # This should be made to accept type handles
			default: none
			writeable: off
			public: on
			required: off
			meta: "Size of the block connected to the port, populated by the compiler from stream connections"
		}
	]
	inherits: []
	meta: "Port attributes are populated by the compiler from stream connections. They are read only (e.g. InputPort.type). Ports have no type or default: these come from the declaration of the bound block."
}

type _Port {
	typeName: "port"
	properties: [
		typeProperty Name {
			name: "name"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		},
		typeProperty Block {
			name: "block"
			allowedTypes: _Block
			required: on
		},
		typeProperty Type {
			name: "allowedTypes"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _DataTypes, _NoneLiteral] } # This should be made to accept type handles
			default: none # None means undefined. Should be resolved from context, and if not possible should resolve to _DefaultSignalType
			required: off
		},
	]
	inherits: [_Base]
	meta: ""
}


type _Callable {
	typeName: "callable"
	properties: [
		typeProperty Ports {
			name: "ports"
			allowedTypes: constrainedList { allowed: [_MainOutputPort, _MainInputPort, _PropertyOutputPort, _PropertyInputPort] } 
			default: []
			required: off
		}
	]
	meta: "Objects can be used as functions within streams"
}
