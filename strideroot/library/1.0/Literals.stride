# Literals for port type validation

type _StringLiteral {
	typeName: "_stringLiteral"
	properties: [
		typeProperty Value {
			name: "value"
			allowedTypes: _StringLiteral
			default: ""
			required: off
		}
	]
}

type _IntLiteral {
	typeName: "_intLiteral"
	properties: [
		typeProperty Value {
			name: "value"
			allowedTypes: _IntLiteral
			default: 1
			required: off
		}
	]
}

type _RealLiteral {
	typeName: "_realLiteral"
	properties: [
		typeProperty Value {
			name: "value"
			allowedTypes: _RealLiteral
			default: 0.0
			required: off
		}
	]
}


type _PortProperty {
	typeName: "_portProperty"
	properties: [
#		typeProperty Value {
#			name: "value"
#			allowedTypes: _Any
#			default: none
#			required: off
#		}
	]
}

type _MemberAccess {
	typeName: "_memberAccess"
	properties: [
	]
	meta: "Member access of a block property, e.g. InputPort.type"
}

type _SwitchLiteral {
	typeName: "_switchLiteral"
	properties: [
#		typeProperty Value {
#			name: "value"
#			allowedTypes: _Any
#			default: none
#			required: off
#		}
	]
}

type _NoneLiteral {
	typeName: "_noneLiteral"
	properties: [
