type _Constant {
	typeName: "constant"
	properties: [
		typeProperty Value {
			name: "value"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _IntLiteral, _RealLiteral, _SwitchLiteral, _Constant, _ResourceType, _NoneLiteral] }
			default: none
			required: off
#			meta: "The constant value"
		}
	]
	meta: "Holds a constant value"
}

# TODO: Default to switch should be MasterReset
type _Switch {
	typeName: "switch"
	properties: [
		typeProperty Default {
			name: "default"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
		}
	]
	inherits: [_Streamable, _Rated, _DomainMember, _Resetable]
}

type _Trigger {
	typeName: "trigger"
	properties: [
	]
	inherits: [_Streamable, _DomainMember]
}

type _Signal {
	typeName: "signal"
	properties: [
		typeProperty Value {
			name: "value"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _RealLiteral] }
			default: 0.0
			required: off
		},
		typeProperty Default {
			name: "default"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _RealLiteral] }
			default: 0.0
			required: off
		}
	]
	inherits: [_Streamable, _Rated, _Typed, _DomainMember, _Resetable]
}

type _Buffer {
	typeName: "buffer"
	properties: [
		typeProperty TypePort {
			name: "type"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty SizePort {
			name: "size"
			allowedTypes: _IntLiteral
			required: on
		},
		typeProperty RatePort {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty DefaultPort {
			name: "default"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _RealLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty _InternalType {
			name: "_internalType"
			allowedTypes: _Any
			default: _RingBufferType
			required: off
		}
	]
	inherits: [_DomainMember, _Resetable]
}


type _Table {
	typeName: "table"
	properties: [
		typeProperty SizePort {
			name: "size"
			allowedTypes: _IntLiteral
			required: on
		},
		typeProperty RatePort {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty TypePort {
			name: "type"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty _InternalType {
			name: "_internalType"
			allowedTypes: _Any
			default: _TableType
			required: off
		}
	]
	inherits: [_DomainMember, _Resetable]
}

type _String {
	typeName: "string"
	properties: [
		typeProperty Default {
			name: "default"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: "Initial and default value"
		}
		typeProperty MaxSize {
			name: "maxSize"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "Maximum size of the string"
		}
		typeProperty PreAllocate {
			name: "preallocate"
			allowedTypes: _IntLiteral
			default: 0
			required: off
			meta: "Preallocate to size"
		}
	]
	meta: "Strings with variable length. Not rated, so reactive."

	inherits: [_Streamable, _DomainMember, _Resetable]
}

type _StreamType {
	typeName: "_stream"
	properties: [
#		typeProperty Value {
#			name: "value"
#			allowedTypes: _Any
#			default: none
#			required: off
#		}
	]
}

type _IteratorType {
	typeName: "iterator"
	properties: [
		typeProperty Default {
			name: "default"
			allowedTypes: _IntLiteral
			default: 0
			required: off
			meta: "Starting value for iterator"
		},
		typeProperty Increment {
			name: "increment"
			allowedTypes: _IntLiteral
			default: 1
			required: off
		},
		typeProperty Limit {
			name: "limit"
			allowedTypes: _IntLiteral
			required: on
			meta: "stop before reaching this value"
		},
		typeProperty Rate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _NoneLiteral] }
			default: none
			required: off
			meta: "Not supported yet, but could be of use in the future"
		},
		typeProperty Domain {
			name: "domain"
			allowedTypes: constrainedEntity { allowed: [_Domain, _NoneLiteral] }
			default: none
			required: off
			meta: "Not supported yet, but could be of use in the future"
		},
		typeProperty Reset {
			name: "reset"
			allowedTypes: constrainedEntity { allowed: [_Trigger, _Signal, _Switch, _NoneLiteral] }
			default: none
			required: off
			meta: "This trigger will reset this iterator when triggered"
		}
		typeProperty Done {
			name: "done"
			allowedTypes: constrainedEntity { allowed: [_Trigger, _Signal, _Switch, _NoneLiteral] }
			default: none
			required: off
			meta: "This trigger will be triggered when the iterator finishes a whole run"
		}
	]
	inherits: [_Base]
}

type _GroupType {
	typeName: "group"
	properties: [
		typeProperty Members {
			name: "members"
			allowedTypes: constrainedList { allowed: [_Streamable] }
			required: on
			meta: "Members of the group"
		}
	]
	meta: "Groups signals for block processing. Guarantees that all signals are processed together."
}
