type _TransitionType {
    typeName: "transition"
	properties: [
		typeProperty {
			name: "signal"
			allowedTypes: constrainedEntity { allowed: [_Signal, _Switch, _StringLiteral, _PortProperty, _NoneLiteral] }
			default: none
			required: off
			meta: "The event or signal that triggers this transition."
		},
		typeProperty {
			name: "label"
			allowedTypes: _StringLiteral
			default: ""
			required: off
			meta: "The label or description for this transition."
		},
		typeProperty {
			name: "guard"
			allowedTypes: constrainedEntity { allowed: [_Streamable, _List, _IntLiteral, _SwitchLiteral, _NoneLiteral, _Any] }
			default: none
			required: off
			meta: "Guard signal or variable block required for the transition (or none)."
		},
		typeProperty {
			name: "triggerOnGuard"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "If on, transition triggers directly on guard signal changes."
		},
		typeProperty {
			name: "onTransition"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Stream expressions to execute during the transition."
		},
		typeProperty {
			name: "targetState"
			allowedTypes: constrainedEntity { allowed: [_StateType, _NoneLiteral] }
			default: none
			required: off
			meta: "The target state for the transition."
		}
    ]
    inherits: [_Base]
}

type _StateType {
    typeName: "state"
    properties: [
		typeProperty {
			name: "states"
			allowedTypes: constrainedList {
				uniqueItems: on
				allowed: [_StateType]
			}
			default: []
			required: off
			meta: "Sub-states for hierarchical state machines."
		},
		typeProperty {
			name: "initialState"
			allowedTypes: constrainedEntity { allowed: [_StateType, _NoneLiteral] }
			default: none
			required: off
			meta: "The default sub-state to enter when this state becomes active."
		},
		typeProperty {
			name: "isParallel"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "If on, all child states are active concurrently (orthogonal regions)."
		},
		typeProperty {
			name: "resumeLastState"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "If on, remembers and resumes the last active child state(s) upon re-entry instead of defaulting to initialState."
		},
		typeProperty {
			name: "isFinal"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "If on, reaching this state indicates completion of its parent state."
		},
		typeProperty {
			name: "blocks"
			allowedTypes: constrainedList { allowed: [_Streamable, _Reaction, _Module] }
			default: []
			required: off
			meta: "Context or shared variables available within this state."
		},
		typeProperty {
			name: "updateGuard"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Stream expressions executed to update guard conditions before transition evaluation."
		},
		typeProperty {
			name: "updateGuardOnDomain"
			allowedTypes: _SwitchLiteral
			default: off
			required: off
			meta: "If on, updateGuard streams execute unconditionally on every domain tick."
		},
		typeProperty {
			name: "onEntry"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Stream expressions executed exactly once when entering this state."
		},
		typeProperty {
			name: "onProcess"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Stream expressions executed continuously while in this state (e.g., per tick)."
		},
		typeProperty {
			name: "onExit"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			default: []
			required: off
			meta: "Stream expressions executed exactly once before exiting this state."
		},
		typeProperty {
			name: "onDone"
			allowedTypes: constrainedList {
				allowed: [_TransitionType]
			}
			default: []
			required: off
			meta: "Transitions to evaluate automatically when this state reaches a final child state."
		},
		typeProperty {
			name: "transitions"
			allowedTypes: constrainedList {
				allowed: [_TransitionType]
			}
			default: []
			required: off
			meta: "Valid transitions originating from this state."
		}
    ]
    inherits: [_Base]
}
