type _PlatformOperatorType {
	typeName: "platformOperator"

	properties: [
		typeProperty Type {
			name: "type"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _NoneLiteral] }
			default: none
			required: off
		},
		typeProperty LeftTypesProperty {
			name: "leftTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
		},
		typeProperty RightTypesProperty {
			name: "rightTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
