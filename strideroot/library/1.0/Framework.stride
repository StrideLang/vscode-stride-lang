		},
		typeProperty LeftDataTypesProperty {
			name: "leftDataTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
			required: off
			meta: "Allowed data types for left element"
		},
		typeProperty RightDataTypesProperty {
			name: "rightDataTypes"
			allowedTypes: constrainedList { allowed: [_Base, _StringLiteral, _Any] }
			default: []
