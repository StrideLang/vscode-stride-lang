type _PlatformModuleType {
	typeName: "platformModule"
	properties: [
		typeProperty Inputs {
			name: "inputs"
			allowedTypes: constrainedList { allowed: [_DataTypes, _Variadic, _PlatformModulePortType, _Port, _StringLiteral] }
			default: []
			required: off
		},
		typeProperty Outputs {
			name: "outputs"
			allowedTypes: constrainedList { allowed: [_DataTypes, _Variadic, _PlatformModulePortType, _Port, _StringLiteral] }
			default: []
			required: off
		},
		typeProperty Ports {
			name: "ports"
			allowedTypes: constrainedList { allowed: [_DataTypes, _Variadic, _PlatformModulePortType, _Port, _StringLiteral] }
			default: []
