loop AllOn {
    ports: [
        mainInputPort InputPort {
            block: AllOn_Input
            meta: "Array of switches to be checked"
        },
        mainOutputPort OutputPort {
            block: AllOn_Output
            meta: "Switch that is on only if all input switches are on"
        }
    ]
    blocks: [
        switch AllOn_Input[InputPort.size] {
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        switch AllOn_Output {
            default: on
            rate: OutputPort.rate
            domain: OutputPort.domain
            reset: AllOn_Reset
        },
        signal AllOn_Index {
            default: 0
            rate: none
            type: Int
            domain: OutputPort.domain
            reset: AllOn_Reset
        },
        switch AllOn_Done {
            domain: OutputPort.domain
        },
        trigger AllOn_Reset {}
    ]
    onExecution: AllOn_Reset
    terminateWhen: AllOn_Done
    streams: [
        [AllOn_Output, AllOn_Input[AllOn_Index]] >> And() >> AllOn_Output;
        AllOn_Index + 1 >> AllOn_Index;
        [AllOn_Index, InputPort.size] >> Equal() >> AllOn_Done;
    ]
    meta: "Outputs on if all switches in the input array are on: Input >> AllOn() >> Output."
}

loop AllOff {
    ports: [
        mainInputPort InputPort {
            block: AllOff_Input
            meta: "Array of switches to be checked"
        },
        mainOutputPort OutputPort {
            block: AllOff_Output
            meta: "Switch that is on only if all input switches are off"
        }
    ]
    blocks: [
        switch AllOff_Input[InputPort.size] {
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        switch AllOff_Output {
            default: on
            rate: OutputPort.rate
            domain: OutputPort.domain
            reset: AllOff_Reset
        },
        switch AllOff_InputOff {
            rate: OutputPort.rate
            domain: OutputPort.domain
        },
        signal AllOff_Index {
            default: 0
            rate: none
            type: Int
            domain: OutputPort.domain
            reset: AllOff_Reset
        },
        switch AllOff_Done {
            domain: OutputPort.domain
        },
        trigger AllOff_Reset {}
    ]
    onExecution: AllOff_Reset
    terminateWhen: AllOff_Done
    streams: [
        AllOff_Input[AllOff_Index] >> Not() >> AllOff_InputOff;
        [AllOff_Output, AllOff_InputOff] >> And() >> AllOff_Output;
        AllOff_Index + 1 >> AllOff_Index;
        [AllOff_Index, InputPort.size] >> Equal() >> AllOff_Done;
    ]
    meta: "Outputs on if all switches in the input array are off: Input >> AllOff() >> Output."
}
