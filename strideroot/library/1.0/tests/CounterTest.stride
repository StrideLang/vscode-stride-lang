# CounterTest.stride
# Unit tests for strideroot/library/1.0/Counter.stride

functionTest CounterBasicTest {
    target: Counter
    prepare: [
        [ 0, 0, 0, 0, 0 ]   >> StartValue;
        [ 3, 3, 3, 3, 3 ]   >> StopValue;
        [ 1, 1, 1, 1, 1 ]   >> Increment;
    ]
    validate: [
        [ Output, [ 1, 2, 3, 0, 1 ] ] >> ExpectEqual();
    ]
}

functionTest CounterStepTest {
    target: Counter
    prepare: [
        [ 0,  0,  0,  0  ]   >> StartValue;
        [ 10, 10, 10, 10 ]   >> StopValue;
        [ 2,  2,  2,  2  ]   >> Increment;
    ]
    validate: [
        [ Output, [ 2, 4, 6, 8 ] ] >> ExpectEqual();
    ]
}
