# BasicOperationsTest.stride
# Unit tests for strideroot/library/1.0/BasicOperations.stride

functionTest SumTest {
    target: Sum
    prepare: [
        [ [ 1.0, 2.0, 3.0, 4.0 ] ] >> Sum_Input;
    ]
    validate: [
        [ Sum_Output, [ 10.0 ] ] >> ExpectNear(epsilon: 0.0001);
    ]
}

functionTest AverageTest {
    target: Average
    prepare: [
        [ [ 2.0, 4.0, 6.0, 8.0 ] ] >> Input;
    ]
    validate: [
        [ Output, [ 5.0 ] ] >> ExpectNear(epsilon: 0.0001);
    ]
}

functionTest ClipTest {
    target: Clip
    prepare: [
        [ -0.5, 0.2, 0.8, 1.5 ] >> Input;
        [ 0.0,  0.0, 0.0, 0.0 ] >> MinVal;
        [ 1.0,  1.0, 1.0, 1.0 ] >> MaxVal;
    ]
    validate: [
        [ Output, [ 0.0, 0.2, 0.8, 1.0 ] ] >> ExpectNear(epsilon: 0.0001);
    ]
}
