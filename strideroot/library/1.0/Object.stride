type _Alias {
	typeName: "alias"
	properties: [
		typeProperty Entity {
			name: "entity"
			allowedTypes: _Any
			default: none
			required: off
			meta: "What the alias stands for. Aliases of aliases are followed to any depth"
		}
	]
	meta: "Another name for an entity, e.g. alias Int { entity: Int32 }"
}

type _Typed {
	typeName: "_typed"
	properties: [
		typeProperty TypeProperty {
			name: "type"
			allowedTypes: [_NumericTypes, _MemberAccess, _NoneLiteral] # typeClass provided by the framework, or a port attribute (e.g. InputPort.type)
			default: none # Resolved from stream connections, otherwise the first member of _NumericTypes
			required: off
		}
	]
}

type _Streamable {
	typeName: "_streamable"
	properties: [
		typeProperty InputName {
			name: "inputName"
			allowedTypes: _Any
			default: none
			required: off
		},
		typeProperty OutputName {
			name: "outputName"
			allowedTypes: _Any
			default: none
			required: off
		}
	]
	inherits: []
}

type _Resetable {
	typeName: "_resetable"
	properties: [
		typeProperty Reset {
			name: "reset"
			allowedTypes: constrainedEntity { allowed: [_Any, _NoneLiteral] }
			default: none
			required: off
		}
	]
}

type _Rated {
	typeName: "rated"
	properties: [
		typeProperty Rate {
			name: "rate"
			allowedTypes: constrainedEntity { allowed: [_IntLiteral, _RealLiteral, _PortProperty, _NoneLiteral] }
			default: none
			required: off
		}
	]
	inherits: []
	meta: "Declarations without a rate are reactive: they take the rate of whatever writes to them"
}

type _DomainMember {
	typeName: "domainMember"
	properties: [
		typeProperty Domain {
			name: "domain"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _DomainDefinition, _NoneLiteral] }
			default: none
			required: off
		}
	]
	inherits: [_Base]
}

type _CodeGenerator {
	typeName: "codeGenerator"
	properties: [
		typeProperty {
			name: "blocks"
			allowedTypes: constrainedList { allowed: [_Streamable, _Reaction, _Module] }
			default: []
			required: off
		},
		typeProperty Streams {
			name: "streams"
			allowedTypes: constrainedList { allowed: [_StreamType] }
			required: on
		}
	]
}

type _Base {
	typeName: "base"
	properties: [
		typeProperty Inherits {
			name: "inherits"
			allowedTypes: constrainedList { allowed: [_StringLiteral, _Base] }
			default: [ _Base ]
			required: off
		},
		typeProperty Meta {
			name: "meta"
			allowedTypes: constrainedEntity { allowed: [_StringLiteral, _Constant] }
			default: ""
			required: off
		}
	]
	inherits: []
}
