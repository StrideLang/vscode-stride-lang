{
    "name": "stride-language",
    "displayName": "Stride Language",
    "description": "Rich language support and Language Server for Stride, state machines, and game definitions",
    "version": "0.1.0",
    "publisher": "StrideLang",
    "engines": {
        "vscode": "^1.75.0"
    },
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:stride"
    ],
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "stride",
        "stridejit",
        "dsp",
        "state-machine",
        "llvm",
        "libgame"
    ],
    "contributes": {
        "languages": [
            {
                "id": "stride",
                "aliases": [
                    "Stride",
                    "stride"
                ],
                "extensions": [
                    ".stride"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "stride",
                "scopeName": "source.stride",
                "path": "./syntaxes/stride.tmLanguage.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "stride",
                "scopes": {
                    "type.defaultLibrary": [
                        "support.type.primitive.stride"
                    ],
                    "type": [
                        "entity.name.type.class.stride"
                    ],
                    "class": [
                        "entity.name.type.class.stride"
                    ],
                    "function.defaultLibrary": [
                        "support.function.stride"
                    ],
                    "function": [
                        "entity.name.function.stride"
                    ],
                    "variable": [
                        "variable.other.constant.stride"
                    ],
                    "property": [
                        "keyword.control.property.stride"
                    ]
                }
            }
        ],
        "snippets": [
            {
                "language": "stride",
                "path": "./snippets/stride.json"
            }
        ],
        "commands": [
            {
                "command": "stride.runTest",
                "title": "Stride: Run Unit Tests in File",
                "category": "Stride"
            },
            {
                "command": "stride.compileFile",
                "title": "Stride: Compile File to Disk",
                "category": "Stride"
            },
            {
                "command": "stride.buildAndFlash",
                "title": "Stride: Build and Flash / Run (Future)",
                "category": "Stride"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "command": "stride.compileFile",
                    "when": "resourceLangId == stride",
                    "group": "navigation@1"
                },
                {
                    "command": "stride.runTest",
                    "when": "resourceLangId == stride",
                    "group": "navigation@2"
                }
            ],
            "editor/context": [
                {
                    "command": "stride.compileFile",
                    "when": "resourceLangId == stride",
                    "group": "stride@1"
                },
                {
                    "command": "stride.runTest",
                    "when": "resourceLangId == stride",
                    "group": "stride@2"
                },
                {
                    "command": "stride.buildAndFlash",
                    "when": "resourceLangId == stride",
                    "group": "stride@3"
                }
            ]
        },
        "debuggers": [
            {
                "type": "stride",
                "label": "Stride",
                "languages": [
                    "stride"
                ],
                "configurationSnippets": [
                    {
                        "label": "Stride: Run Unit Tests in File",
                        "description": "Run unit tests in the active Stride file",
                        "body": {
                            "type": "stride",
                            "request": "launch",
                            "name": "Stride: Run Unit Tests in File",
                            "mode": "test",
                            "file": "${file}"
                        }
                    },
                    {
                        "label": "Stride: Compile File to Disk",
                        "description": "Compile the active Stride file to an object file (.o) and C header (.h)",
                        "body": {
                            "type": "stride",
                            "request": "launch",
                            "name": "Stride: Compile File to Disk",
                            "mode": "compile",
                            "file": "${file}",
                            "output": "${fileDirname}/${fileBasenameNoExtension}.o",
                            "header": "${fileDirname}/${fileBasenameNoExtension}.h"
                        }
                    },
                    {
                        "label": "Stride: Build and Flash / Run (Future)",
                        "description": "Build and flash/run Stride program on target hardware (Future feature)",
                        "body": {
                            "type": "stride",
                            "request": "launch",
                            "name": "Stride: Build and Flash / Run (Future)",
                            "mode": "flash",
                            "file": "${file}"
                        }
                    }
                ]
            }
        ],
        "configuration": {
            "title": "Stride",
            "properties": {
                "stride.server.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Stride Language Server binary (stride-lsp.exe)."
                },
                "stride.stridecPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Stride Compiler binary (stridec.exe). If empty, auto-discovery is used."
                },
                "stride.stridetestPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Stride Unit Test Runner binary (stridetest.exe). If empty, auto-discovery is used."
                },
                "stride.strideroot": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Stride root directory containing standard library definitions (overrides environment variable and bundled fallback library)."
                },
                "stride.includePaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional search paths for Stride system and domain definitions."
                },
                "stride.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the Stride language server."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/node": "^18.19.0",
        "@types/vscode": "^1.75.0",
        "typescript": "^5.3.3"
    }
}