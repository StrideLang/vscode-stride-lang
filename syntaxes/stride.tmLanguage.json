{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Stride",
	"scopeName": "source.stride",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#apostrings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#builtin-types"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#block-declarations"
		},
		{
			"include": "#generic-declarations"
		},
		{
			"include": "#function-call"
		},
		{
			"include": "#scope-resolution"
		},
		{
			"include": "#port-property"
		},
		{
			"include": "#property-label"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.stride",
					"match": "#.*$"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.stride",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.stride",
					"match": "\\\\."
				},
				{
					"name": "constant.other.placeholder.stride",
					"match": "%%[a-zA-Z0-9_:]+%%"
				}
			]
		},
		"apostrings": {
			"name": "string.quoted.single.stride",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.stride",
					"match": "\\\\."
				},
				{
					"name": "constant.other.placeholder.stride",
					"match": "%%[a-zA-Z0-9_:]+%%"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.stride",
					"match": "\\b0x[0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.float.stride",
					"match": "\\b[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?\\b|\\b\\.[0-9]+([eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
				},
				{
					"name": "constant.numeric.integer.stride",
					"match": "\\b[0-9]+\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.stride",
					"match": "\\b(on|off)\\b"
				},
				{
					"name": "constant.language.null.stride",
					"match": "\\bnone\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.import.stride",
					"match": "\\b(import|use|version|with|as|for)\\b"
				},
				{
					"name": "keyword.other.stride",
					"match": "\\b(streamRate)\\b"
				},
				{
					"name": "keyword.operator.logical.word.stride",
					"match": "\\b(and|or|not)\\b"
				}
			]
		},
		"builtin-types": {
			"patterns": [
				{
					"name": "support.type.primitive.stride",
					"match": "\\b(_IntType|_RealType|_SwitchType|_StateType|_DomainDefinition|_Signal|_RootContext|_DomainFunction|_JitFramework|_GameFramework)\\b"
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"match": "\\b(_domainDefinition|platformModule|platformFunction|module|reaction|loop|state|transition|type)\\s+(_*[a-zA-Z0-9_]+)(?:\\s*(@\\s*[_a-zA-Z0-9]+))?",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						},
						"2": {
							"name": "entity.name.type.class.stride"
						},
						"3": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				}
			]
		},
		"block-declarations": {
			"patterns": [
				{
					"match": "\\b(signal|switch|trigger|mainInputPort|mainOutputPort|propertyInputPort|propertyOutputPort|typeProperty)\\s+(_*[a-zA-Z0-9_]+)(?:\\s*\\[[^\\]]*\\])?",
					"captures": {
						"1": {
							"name": "storage.type.block.stride"
						},
						"2": {
							"name": "variable.other.constant.stride"
						}
					}
				}
			]
		},
		"generic-declarations": {
			"patterns": [
				{
					"match": "\\b([_a-z][a-zA-Z0-9_]*)\\s+([_A-Z][a-zA-Z0-9_]*)(?:\\s*\\[[^\\]]*\\])?(?:\\s*(@)\\s*([_a-zA-Z0-9]+))?\\s*(?=\\{)",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						},
						"2": {
							"name": "entity.name.type.class.stride"
						},
						"3": {
							"name": "punctuation.definition.annotation.stride"
						},
						"4": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				}
			]
		},
		"function-call": {
			"patterns": [
				{
					"match": "\\b(_*[A-Z][a-zA-Z0-9_]*)\\s*(?:(@)\\s*([_a-zA-Z0-9]+))?\\s*\\(",
					"captures": {
						"1": {
							"name": "entity.name.function.stride"
						},
						"2": {
							"name": "punctuation.definition.annotation.stride"
						},
						"3": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				}
			]
		},
		"scope-resolution": {
			"patterns": [
				{
					"match": "\\b(_*[a-zA-Z0-9_]+)\\s*(::)",
					"captures": {
						"1": {
							"name": "entity.name.namespace.stride"
						},
						"2": {
							"name": "punctuation.accessor.scope.stride"
						}
					}
				}
			]
		},
		"port-property": {
			"patterns": [
				{
					"match": "\\b(_*[A-Z][a-zA-Z0-9_]*)\\.(_*[a-zA-Z0-9_]+)",
					"captures": {
						"1": {
							"name": "variable.other.object.stride"
						},
						"2": {
							"name": "variable.other.property.stride"
						}
					}
				},
				{
					"match": "\\.(_*[a-zA-Z0-9_]+)",
					"captures": {
						"1": {
							"name": "variable.other.property.stride"
						}
					}
				}
			]
		},
		"property-label": {
			"patterns": [
				{
					"match": "\\b(domain|type|framework|rate|default|reset|targetState|guard|onTransition|terminateWhen|meta|name|block|ports|blocks|streams|states|transitions|initialState|processing|inherits|substitutions|domainIncludes|inputs|outputs|stateMachines|typeName|properties)\\s*(:)\\s*([_A-Z][a-zA-Z0-9_]*)?",
					"captures": {
						"1": {
							"name": "entity.other.attribute-name.stride"
						},
						"2": {
							"name": "punctuation.separator.key-value.stride"
						},
						"3": {
							"name": "entity.name.type.class.stride"
						}
					}
				},
				{
					"match": "\\b(_*[a-zA-Z0-9_]+)\\s*(:)",
					"captures": {
						"1": {
							"name": "entity.other.attribute-name.stride"
						},
						"2": {
							"name": "punctuation.separator.key-value.stride"
						}
					}
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.stream.stride",
					"match": ">>"
				},
				{
					"name": "keyword.operator.logical.stride",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.bitwise.stride",
					"match": "&|\\||~"
				},
				{
					"name": "keyword.operator.arithmetic.stride",
					"match": "\\+|-|\\*|/"
				},
				{
					"name": "punctuation.definition.annotation.stride",
					"match": "@"
				},
				{
					"name": "punctuation.terminator.statement.stride",
					"match": ";"
				},
				{
					"name": "punctuation.separator.comma.stride",
					"match": ","
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "variable.other.constant.stride",
					"match": "\\b(_*[A-Z][a-zA-Z0-9_]*)\\b"
				},
				{
					"name": "variable.language.stride",
					"match": "\\b(_*[a-z][a-zA-Z0-9_]*)\\b"
				}
			]
		}
	}
}
