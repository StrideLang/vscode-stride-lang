{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Stride",
	"scopeName": "source.stride",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#apostrings"
		},
		{
			"include": "#directives"
		},
		{
			"include": "#range-operator"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#property-label"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#builtin-types"
		},
		{
			"include": "#builtin-functions"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#block-declarations"
		},
		{
			"include": "#generic-declarations"
		},
		{
			"include": "#function-call"
		},
		{
			"include": "#scope-resolution"
		},
		{
			"include": "#member-access"
		},
		{
			"include": "#port-property"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.stride",
					"match": "#.*$"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.stride",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.stride",
					"match": "\\\\."
				},
				{
					"name": "constant.other.placeholder.stride",
					"match": "%%[a-zA-Z0-9_:]+%%"
				}
			]
		},
		"apostrings": {
			"name": "string.quoted.single.stride",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.stride",
					"match": "\\\\."
				},
				{
					"name": "constant.other.placeholder.stride",
					"match": "%%[a-zA-Z0-9_:]+%%"
				}
			]
		},
		"directives": {
			"patterns": [
				{
					"name": "meta.directive.with.stride",
					"begin": "(@with)\\s*(\\()",
					"beginCaptures": {
						"1": {
							"name": "entity.other.attribute-name.annotation.stride keyword.control.directive.stride"
						},
						"2": {
							"name": "punctuation.section.parens.begin.stride"
						}
					},
					"end": "\\)",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.parens.end.stride"
						}
					},
					"patterns": [
						{
							"include": "#feature-expression"
						}
					]
				},
				{
					"name": "meta.directive.force.stride",
					"begin": "(@force)\\s*(\\()",
					"beginCaptures": {
						"1": {
							"name": "entity.other.attribute-name.annotation.stride keyword.control.directive.stride"
						},
						"2": {
							"name": "punctuation.section.parens.begin.stride"
						}
					},
					"end": "\\)",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.parens.end.stride"
						}
					},
					"patterns": [
						{
							"include": "#feature-expression"
						}
					]
				},
				{
					"match": "(@(?:with|force))\\b",
					"captures": {
						"1": {
							"name": "entity.other.attribute-name.annotation.stride keyword.control.directive.stride"
						}
					}
				}
			]
		},
		"feature-expression": {
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"name": "keyword.operator.logical.stride",
					"match": "&&|\\|\\||!"
				},
				{
					"include": "#scope-resolution"
				},
				{
					"include": "#identifiers"
				},
				{
					"name": "meta.group.parens.stride",
					"begin": "\\(",
					"beginCaptures": {
						"0": {
							"name": "punctuation.section.parens.begin.stride"
						}
					},
					"end": "\\)",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.parens.end.stride"
						}
					},
					"patterns": [
						{
							"include": "#feature-expression"
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.stride",
					"match": "\\b(0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*)([iu](?:8|16|32|64)|u|usize)?\\b",
					"captures": {
						"2": {
							"name": "storage.type.numeric.stride"
						}
					}
				},
				{
					"name": "constant.numeric.binary.stride",
					"match": "\\b(0[bB][01](?:_?[01])*)([iu](?:8|16|32|64)|u|usize)?\\b",
					"captures": {
						"2": {
							"name": "storage.type.numeric.stride"
						}
					}
				},
				{
					"name": "constant.numeric.float.stride",
					"match": "\\b([0-9](?:_?[0-9])*\\.(?!\\.)(?:[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*)(f(?:32|64))?\\b",
					"captures": {
						"2": {
							"name": "storage.type.numeric.stride"
						}
					}
				},
				{
					"name": "constant.numeric.float.stride",
					"match": "(?<![0-9a-zA-Z_.])(\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(f(?:32|64))?\\b",
					"captures": {
						"2": {
							"name": "storage.type.numeric.stride"
						}
					}
				},
				{
					"name": "constant.numeric.float.stride",
					"match": "\\b([0-9](?:_?[0-9])*)(f(?:32|64))\\b",
					"captures": {
						"2": {
							"name": "storage.type.numeric.stride"
						}
					}
				},
				{
					"name": "constant.numeric.integer.stride",
					"match": "\\b([0-9](?:_?[0-9])*)([iu](?:8|16|32|64)|u|usize)?\\b",
					"captures": {
						"2": {
							"name": "storage.type.numeric.stride"
						}
					}
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.stride",
					"match": "\\b(on|off)\\b"
				},
				{
					"name": "constant.language.null.stride",
					"match": "\\bnone\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.import.stride",
					"match": "\\b(import|use|version|with|as|for|in|feature)\\b"
				},
				{
					"name": "keyword.other.stride",
					"match": "\\b(streamRate)\\b"
				},
				{
					"name": "keyword.operator.logical.word.stride",
					"match": "\\b(and|or|not)\\b"
				}
			]
		},
		"builtin-types": {
			"patterns": [
				{
					"name": "support.type.primitive.stride",
					"match": "\\b(_Alias|_Any|_Base|_Buffer|_BufferType|_Callable|_CodeGenerator|_ConnectionType|_Constant|_ConstrainedEntity|_ConstrainedInt|_ConstrainedList|_ConstrainedReal|_ConstrainedString|_Constraint|_DataTypes|_DeviceType|_DomainDefinition|_DomainMember|_DomainResourceType|_Entity|_FloatTypes|_FrameworkDataType|_FrameworkDescriptionType|_FrameworkTypeClass|_FunctionTest|_GroupType|_IntLiteral|_IntType|_IntegerTypes|_IteratorType|_List|_Loop|_MainInputPort|_MainOutputPort|_MemberAccess|_Module|_NoneLiteral|_NumericTypes|_PlatformCodeType|_PlatformEntityType|_PlatformModulePortType|_PlatformModuleType|_PlatformOperatorType|_PlatformType|_PolicyBinding|_Port|_PortAttributes|_PortProperty|_PropertyInputPort|_PropertyOutputPort|_Rated|_Reaction|_RealLiteral|_RealType|_Resetable|_ResourceConfigurationType|_ResourceType|_SequenceType|_Signal|_StateType|_StreamType|_Streamable|_String|_StringLiteral|_StringType|_Switch|_SwitchLiteral|_SwitchType|_SystemType|_Table|_TableType|_TransitionType|_Trigger|_Type|_TypeClass|_TypeClassConversion|_TypeProperty|_Typed|_Variadic)\\b"
				}
			]
		},
		"builtin-functions": {
			"patterns": [
				{
					"name": "support.function.stride",
					"match": "\\b(Abs|AD|And|Average|BandLimitedSaw|BandPass|BiQuad|Clamp|Clip|ComputeMix|CorrectPhase|Cos|Counter|DebugPrint|Divide|Equal|Error|Exit|Exp|ExpectEqual|ExpectFalse|ExpectGe|ExpectGt|ExpectLe|ExpectLt|ExpectNear|ExpectTrue|FallingEdge|Floor|Greater|GreaterOrEqual|Impulse|Inverse|Latch|Lerp|Less|LessOrEqual|Level|LowPass|Map|Max|Min|Mix|Multiply|Nand|NextStep|Nor|Not|NotEqual|OnChange|Or|Oscillator|OSCIn|OSCOut|Pan|Pow|Print|Probe|Rectify|RisingEdge|Select|Sequencer|SerialPrint|Sign|Sin|Smooth|TableOscillator|Tan|Tap|Watch|Wrap|WrapPhase|Xor|__Abs|__And|__Cos|__DebugPrint|__Equal|__ExitDomain|__Exp|__Floor|__Greater|__GreaterOrEqual|__Less|__LessOrEqual|__Nand|__Nor|__Not|__NotEqual|__Or|__OscOut|__Pow|__Select|__Sin|__Tan|__Xor)\\b"
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"match": "\\b(module|reaction|loop)\\s+([_a-zA-Z0-9_]+)(\\s*\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?(?:\\s*(@\\s*[_a-zA-Z0-9]+))?\\s*(?=\\{)",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						},
						"2": {
							"name": "entity.name.function.stride"
						},
						"3": {
							"patterns": [
								{
									"include": "#bracket-contents"
								}
							]
						},
						"4": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				},
				{
					"match": "\\b(_domainDefinition|gameDefinition|domainDeclaration|platformModule|platformFunction|state|transition|action|type|feature)\\s+(_*[a-zA-Z0-9_]+)(\\s*\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?(?:\\s*(@\\s*[_a-zA-Z0-9]+))?",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						},
						"2": {
							"name": "entity.name.type.class.stride"
						},
						"3": {
							"patterns": [
								{
									"include": "#bracket-contents"
								}
							]
						},
						"4": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				},
				{
					"match": "\\b(_domainDefinition|gameDefinition|domainDeclaration|platformModule|platformFunction|module|reaction|loop|state|transition|action|type|feature|signal|switch|trigger|mainInputPort|mainOutputPort|propertyInputPort|propertyOutputPort|port|typeProperty|constant|buffer|table|list|group)\\s*(?=(?:\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?(?:\\s*@[_a-zA-Z0-9]+)?\\s*\\{)",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						}
					}
				},
				{
					"match": "\\b(_domainDefinition|gameDefinition|domainDeclaration|platformModule|platformFunction|module|reaction|loop|state|transition|action|type|feature|signal|switch|trigger|mainInputPort|mainOutputPort|propertyInputPort|propertyOutputPort|port|typeProperty|constant|buffer|table|list|group)\\b",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						}
					}
				}
			]
		},
		"block-declarations": {
			"patterns": [
				{
					"match": "\\b(signal|switch|trigger|mainInputPort|mainOutputPort|propertyInputPort|propertyOutputPort|port|typeProperty|constant|buffer|table|list|group)\\s+(_*[a-zA-Z0-9_]+)(\\s*\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?(?:\\s*(@\\s*[_a-zA-Z0-9]+))?",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						},
						"2": {
							"name": "variable.other.constant.stride"
						},
						"3": {
							"patterns": [
								{
									"include": "#bracket-contents"
								}
							]
						},
						"4": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				},
				{
					"match": "\\b(signal|switch|trigger|mainInputPort|mainOutputPort|propertyInputPort|propertyOutputPort|port|typeProperty|constant|buffer|table|list|group)\\s*(?=(?:\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?(?:\\s*@[_a-zA-Z0-9]+)?\\s*\\{)",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						}
					}
				}
			]
		},
		"generic-declarations": {
			"patterns": [
				{
					"match": "\\b([_a-z][a-zA-Z0-9_]*)\\s+([_A-Z][a-zA-Z0-9_]*)(\\s*\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?(?:\\s*(@)\\s*([_a-zA-Z0-9]+))?\\s*(?=\\{)",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						},
						"2": {
							"name": "entity.name.type.class.stride"
						},
						"3": {
							"patterns": [
								{
									"include": "#bracket-contents"
								}
							]
						},
						"4": {
							"name": "punctuation.definition.annotation.stride"
						},
						"5": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				},
				{
					"match": "\\b([_a-z][a-zA-Z0-9_]*)\\s*(?=(?:\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?(?:\\s*@[_a-zA-Z0-9]+)?\\s*\\{)",
					"captures": {
						"1": {
							"name": "storage.type.declaration.stride"
						}
					}
				}
			]
		},
		"function-call": {
			"patterns": [
				{
					"match": "\\b(_*[a-zA-Z][a-zA-Z0-9_]*)(?:\\[\\])?\\s*(?:(@)\\s*([_a-zA-Z0-9]+))?\\s*\\(",
					"captures": {
						"1": {
							"name": "entity.name.function.stride"
						},
						"2": {
							"name": "punctuation.definition.annotation.stride"
						},
						"3": {
							"name": "entity.other.attribute-name.annotation.stride"
						}
					}
				},
				{
					"match": "(>>)\\s*([_a-zA-Z0-9_]+)(?=(?:\\[[^\\]]*\\])?(?:@\\s*[_a-zA-Z0-9]+)?\\s*>>)",
					"captures": {
						"1": {
							"name": "keyword.operator.stream.stride"
						},
						"2": {
							"name": "entity.name.function.stride"
						}
					}
				}
			]
		},
		"scope-resolution": {
			"patterns": [
				{
					"match": "\\b(_*[a-zA-Z0-9_]+)\\s*(::)",
					"captures": {
						"1": {
							"name": "entity.name.namespace.stride"
						},
						"2": {
							"name": "punctuation.accessor.scope.stride"
						}
					}
				}
			]
		},
		"member-access": {
			"patterns": [
				{
					"match": "\\b(_*[a-zA-Z][a-zA-Z0-9_]*)(\\.)(_*[a-zA-Z][a-zA-Z0-9_]*)",
					"captures": {
						"1": {
							"name": "variable.other.object.stride"
						},
						"2": {
							"name": "punctuation.accessor.dot.stride"
						},
						"3": {
							"name": "keyword.control.property.stride variable.other.property.stride"
						}
					}
				},
				{
					"match": "(\\.)(_*[a-zA-Z][a-zA-Z0-9_]*)",
					"captures": {
						"1": {
							"name": "punctuation.accessor.dot.stride"
						},
						"2": {
							"name": "keyword.control.property.stride variable.other.property.stride"
						}
					}
				}
			]
		},
		"port-property": {
			"patterns": [
				{
					"include": "#member-access"
				}
			]
		},
		"property-label": {
			"patterns": [
				{
					"match": "\\b(_*[a-zA-Z0-9_]+)\\s*(:)(?!:)",
					"captures": {
						"1": {
							"name": "keyword.control.property.stride"
						},
						"2": {
							"name": "punctuation.separator.key-value.stride"
						}
					}
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.stream.stride",
					"match": ">>"
				},
				{
					"name": "keyword.operator.logical.stride",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.bitwise.stride",
					"match": "&|\\||~"
				},
				{
					"name": "keyword.operator.arithmetic.stride",
					"match": "\\+|-|\\*|/"
				},
				{
					"name": "punctuation.definition.annotation.stride",
					"match": "@"
				},
				{
					"name": "punctuation.terminator.statement.stride",
					"match": ";"
				},
				{
					"name": "punctuation.separator.comma.stride",
					"match": ","
				},
				{
					"name": "keyword.operator.range.stride",
					"match": ":"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "variable.other.constant.stride",
					"match": "\\b(_*[A-Z][a-zA-Z0-9_]*)\\b"
				},
				{
					"name": "variable.other.stride",
					"match": "\\b(_*[a-z][a-zA-Z0-9_]*)\\b"
				}
			]
		},
		"bracket-contents": {
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#apostrings"
				},
				{
					"include": "#range-operator"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#constants"
				},
				{
					"include": "#keywords"
				},
				{
					"include": "#builtin-types"
				},
				{
					"include": "#builtin-functions"
				},
				{
					"include": "#function-call"
				},
				{
					"include": "#scope-resolution"
				},
				{
					"include": "#member-access"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#identifiers"
				}
			]
		},
		"range-operator": {
			"patterns": [
				{
					"name": "keyword.operator.range.stride",
					"match": "\\.\\."
				}
			]
		}
	}
}
